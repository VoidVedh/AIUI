# ==============================================================================
# AIUI — Environment Configuration Template
# Copy this file to `.env` to configure optional live Vision/LLM cloud providers.
# Offline CV fallback is used automatically if no API keys are provided.
# ==============================================================================

# Server & Network Ports
PORT=3001
VITE_PORT=5173

# Optional: Google Gemini Vision API Key
# If set, orchestrator uses Gemini 1.5/2.0 Flash for multi-modal perception
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (GPT-4o Vision)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenRouter API Key & Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=https://aiui.dev
OPENROUTER_SITE_NAME=AIUI

# Pipeline Settings
DEFAULT_TARGET_FRAMEWORK=react
DEFAULT_SIMILARITY_THRESHOLD=0.92
DEFAULT_MAX_ITERATIONS=5
LOG_LEVEL=info
