# ==============================================================================
# AIUI — Environment Configuration Template
# Copy this file to `.env` to configure optional live Vision/LLM cloud providers.
# Offline CV fallback is used automatically if no API keys are provided.
# ==============================================================================

# Server & Network Ports
PORT=3001
VITE_PORT=5173

# Default / Free-Tier Provider: Gemma via OpenRouter
# Fully env-driven: set your preferred Gemma model slug (no hardcoded fallback)
GEMMA_MODEL=google/gemma-3-27b-it

# Google Gemini Vision API Key & Optional Model Override
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key & Optional Model Override
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic API Key & Optional Model Override
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Puter → Gemini Provider (Uses your logged-in Puter account or auth token)
PUTER_AUTH_TOKEN=your_puter_auth_token_here
PUTER_MODEL=gemini-2.5-flash

# OpenRouter API Key & Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_SITE_URL=https://aiui.dev
OPENROUTER_SITE_NAME=AIUI

# Pipeline Settings
AI_PROVIDER=puter # Options: puter | openrouter | gemini | openai | anthropic | gemma | offline
DEFAULT_TARGET_FRAMEWORK=react
DEFAULT_SIMILARITY_THRESHOLD=0.92
DEFAULT_MAX_ITERATIONS=5
LOG_LEVEL=info
